public class SampleClass {

    // Method 1: Addition
    public Integer addNumbers(Integer a, Integer b) {
        return a + b;
    }

    // Method 2: Subtraction
    public Integer subtractNumbers(Integer a, Integer b) {
        return a - b;
    }
    // Method 4: Division
    public Integer divideNumbers(Integer a, Integer b) {
        return a / b;
    }
}